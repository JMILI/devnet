# devnet — 网络层配置（可按机器改）
# 代理端口：按你的 Clash / V2Ray / 其他客户端「混合端口 / HTTP 端口」填写
# 常见：Clash 7890，部分客户端 7897 / 10809

DEVNET_PROXY_PORTS="7890 7897 10809 10808 20171 8080"
DEVNET_PROXY_SCHEME="http"          # http | socks5
DEVNET_MODE="auto"                  # auto | on | off

# 无代理时 git 是否走镜像（仅当探测不到 Windows 代理时）
DEVNET_GIT_MIRROR="https://ghproxy.net/"

# 写入 Windows %UserProfile%\.wslconfig 时是否启用镜像网络（推荐）
DEVNET_WSL_MIRRORED="1"
