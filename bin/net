#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/proxy.sh
source "${ROOT}/lib/proxy.sh"

usage() {
  cat <<'EOF'
devnet — WSL 网络层：VPN 可开可关，本地预览与隧道不受影响

Usage:
  net status                 当前代理 / NO_PROXY 状态
  net auto                   探测 Windows 代理：有则开，无则关（默认）
  net on                     强制走代理（探测失败则报错）
  net off                    关闭代理（本地/隧道照常）
  net doctor                 一键体检：代理、GitHub、本机端口、Sealos
  net git-clone <url> [dir]  智能 clone（有代理走 GitHub；无代理走镜像）
  net install                写入 ~/.bashrc 自动加载 + 提示 .wslconfig
  net wslconfig              生成 / 安装 Windows .wslconfig（镜像网络）

环境变量（见 ../config.env）:
  DEVNET_MODE=auto|on|off
  DEVNET_PROXY_PORTS="7890 7897 ..."
  DEVNET_GIT_MIRROR=https://ghproxy.net/
EOF
}

cmd_doctor() {
  devnet_proxy_apply auto
  devnet_status
  echo
  echo "=== connectivity ==="

  local host code
  host="$(devnet_windows_host || true)"
  echo -n "Windows host TCP ping (proxy ports): "
  if endpoint="$(devnet_detect_proxy_endpoint)"; then
    echo "OK → ${endpoint}"
  else
    echo "none open (VPN/proxy off or Allow LAN disabled) — OK for local-only"
  fi

  echo -n "localhost curl (should never use proxy): "
  # Any listening port is fine; 22/sshd often exists. Use /dev/null style check.
  if curl -s -o /dev/null -m 2 --noproxy '*' http://127.0.0.1/ 2>/dev/null; then
    echo "reachable-or-refused (direct)"
  else
    # Connection refused still proves we didn't hang on proxy
    echo "direct path OK (refused/timeout without proxy hang)"
  fi

  echo -n "GitHub HTTPS: "
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 12 https://github.com 2>/dev/null || echo 000)"
  if [ "$code" = "000" ] && [ -n "${DEVNET_GIT_MIRROR:-}" ]; then
    echo "fail (${code}) — will use git mirror when cloning"
    echo -n "  mirror HEAD: "
    curl -s -o /dev/null -w '%{http_code}\n' -m 12 "${DEVNET_GIT_MIRROR}https://github.com/" 2>/dev/null || echo "000"
  else
    echo "HTTP ${code}"
  fi

  echo -n "Sealos (tunnel control plane): "
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 12 https://gzg.sealos.run 2>/dev/null || echo 000)"
  echo "HTTP ${code}"

  echo
  echo "=== local project ports (sample) ==="
  local p
  for p in 18200 5175 18080 4000 3000 5000; do
    if ss -tln 2>/dev/null | grep -q ":${p} "; then
      printf "  :%-5s UP\n" "$p"
    else
      printf "  :%-5s down\n" "$p"
    fi
  done

  echo
  echo "Tips:"
  echo "  • Windows 浏览器访问 WSL 服务: http://127.0.0.1:<port>（需 localhostForwarding 或 mirrored）"
  echo "  • 开 VPN 后执行:  source ~/code_jm/devnet/bin/net && net auto"
  echo "  • 关 VPN 后:      net off   # 或不做；auto 会在新开 shell 时关掉"
  echo "  • 隧道: cd ~/code_jm/deployProject/ProjectAccess && SKIP_TUNNEL=0 bash start_all.sh rust-compile"
}

cmd_git_clone() {
  if [ "$#" -lt 1 ]; then
    echo "Usage: net git-clone <url> [dir]" >&2
    exit 1
  fi
  local url="$1"
  local dir="${2:-}"
  devnet_git_prepare
  echo "[devnet] proxy_state=${DEVNET_PROXY_STATE}"
  if [ -n "$dir" ]; then
    git clone "$url" "$dir"
  else
    git clone "$url"
  fi
}

cmd_install() {
  local marker="# >>> code_jm/devnet >>>"
  local end="# <<< code_jm/devnet <<<"
  local bashrc="${HOME}/.bashrc"
  local block
  block=$(cat <<EOF
${marker}
# Auto: enable Windows proxy when available; never proxy localhost / Sealos.
export DEVNET_ROOT="${ROOT}"
# shellcheck source=/dev/null
source "\${DEVNET_ROOT}/lib/proxy.sh"
devnet_bootstrap
alias net='\${DEVNET_ROOT}/bin/net'
${end}
EOF
)

  touch "$bashrc"
  if grep -qF "$marker" "$bashrc" 2>/dev/null; then
    # Replace existing block
    local tmp
    tmp="$(mktemp)"
    awk -v m="$marker" -v e="$end" '
      $0==m {skip=1; next}
      $0==e {skip=0; next}
      !skip {print}
    ' "$bashrc" >"$tmp"
    cat "$tmp" >"$bashrc"
    rm -f "$tmp"
  fi
  printf '\n%s\n' "$block" >>"$bashrc"
  echo "[devnet] installed into ${bashrc}"
  echo "[devnet] run: source ~/.bashrc   or open a new WSL terminal"
  echo "[devnet] next: ${ROOT}/bin/net wslconfig"
}

cmd_wslconfig() {
  local win_home wslconfig template dest
  win_home="$(wslpath "$(cmd.exe /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')" 2>/dev/null || true)"
  if [ -z "$win_home" ] || [ ! -d "$win_home" ]; then
    win_home="/mnt/c/Users/Administrator"
  fi
  wslconfig="${win_home}/.wslconfig"
  template="${ROOT}/templates/wslconfig.mirrored"
  dest="${ROOT}/templates/wslconfig.generated"

  mkdir -p "${ROOT}/templates"
  cat >"$template" <<'INI'
# Generated by code_jm/devnet — copy to %UserProfile%\.wslconfig then: wsl --shutdown
[wsl2]
# Mirrored: Windows localhost ↔ WSL localhost; Windows proxy on 127.0.0.1 works in WSL.
networkingMode=mirrored
dnsTunneling=true
autoProxy=true
# Keep localhostForwarding if you stay on NAT instead of mirrored:
# localhostForwarding=true

[experimental]
# Host address loopback helps some Windows→WSL edge cases
hostAddressLoopback=true
INI

  cp "$template" "$dest"
  echo "[devnet] template: ${template}"

  if [ "${1:-}" = "--apply" ] || [ "${DEVNET_WSL_MIRRORED:-1}" = "1" ]; then
    if [ -f "$wslconfig" ]; then
      cp "$wslconfig" "${wslconfig}.bak.$(date +%Y%m%d%H%M%S)"
      echo "[devnet] backed up existing ${wslconfig}"
    fi
    cp "$template" "$wslconfig"
    echo "[devnet] wrote ${wslconfig}"
    echo "[devnet] Apply with PowerShell:  wsl --shutdown"
    echo "[devnet] Then reopen Ubuntu. Windows 浏览器继续用 http://127.0.0.1:<port>"
  else
    echo "[devnet] dry-run only. To install:  net wslconfig --apply"
  fi
}

main() {
  local cmd="${1:-status}"
  shift || true
  case "$cmd" in
    status)   devnet_proxy_apply "${DEVNET_MODE:-auto}" >/dev/null 2>&1 || true; devnet_status ;;
    auto)     DEVNET_MODE=auto; devnet_proxy_apply auto; devnet_status ;;
    on)       DEVNET_MODE=on;  devnet_proxy_apply on;  devnet_status ;;
    off)      DEVNET_MODE=off; devnet_proxy_apply off; devnet_status ;;
    doctor)   cmd_doctor ;;
    git-clone) cmd_git_clone "$@" ;;
    install)  cmd_install ;;
    wslconfig) cmd_wslconfig "$@" ;;
    -h|--help|help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
