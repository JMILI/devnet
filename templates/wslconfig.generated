# Generated by code_jm/devnet — copy to %UserProfile%\.wslconfig then: wsl --shutdown
[wsl2]
# Mirrored: Windows localhost ↔ WSL localhost; Windows proxy on 127.0.0.1 works in WSL.
networkingMode=mirrored
dnsTunneling=true
autoProxy=true
# Keep localhostForwarding if you stay on NAT instead of mirrored:
# localhostForwarding=true

[experimental]
# Host address loopback helps some Windows→WSL edge cases
hostAddressLoopback=true
